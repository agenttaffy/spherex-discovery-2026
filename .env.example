# SPHEREx Discovery Environment Configuration
PORT=8000
HOST=0.0.0.0
# Leave unset for the built-in localhost origins. Set empty for same-origin deployments.
# For direct cross-origin browser access, list the exact frontend origins without paths.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# IRSA Services
IRSA_SIA_BASE_URL=https://irsa.ipac.caltech.edu/SIA
IRSA_TAP_BASE_URL=https://irsa.ipac.caltech.edu/TAP/sync
IRSA_IBE_BASE_URL=https://irsa.ipac.caltech.edu/ibe/data/spherex

# The backend resolves its local cache at data/cache relative to the repository.

# Science Settings
DEFAULT_FOV_DEG=0.1
MAX_FOV_DEG=0.5
DEFAULT_COLLECTION=spherex_dr1
SPHEREX_SEARCH_COLLECTIONS=spherex_dr1,spherex_qr3
# Dated DR1 cube layout used only if discovery cannot provide a tile.
# Update after verifying the published IRSA product layout, then restart the backend.
SPHEREX_DR1_CUBE_VERSION=hips_20261026
# Optional absolute path to a staged manifest. Its directory must contain the staged FITS files.
# SPHEREX_DEMO_MANIFEST=
